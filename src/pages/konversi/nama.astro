---
// /konversi/nama: Latin names to Arabic script, in the browser
// (src/lib/nama-arab.ts). One name, or a list pasted from a spreadsheet
// column, one name per line. Nothing is sent anywhere.
import ContentPage from '@/components/content/ContentPage.astro';
import { school } from '@/lib/site';
---
<ContentPage
  closing="compact"
  title="Nama Latin ke Arab"
  lede="Tulis nama dengan huruf Latin, dapatkan tulisan Arabnya. Bisa satu nama, atau banyak nama sekaligus untuk papan nama dan syahadah."
  crumbs={[{ label: 'Layanan' }, { label: 'Nama Latin ke Arab' }]}
  description="Ubah nama Latin ke tulisan Arab, satu per satu atau banyak sekaligus."
>
  <form data-nama class="flex flex-col gap-12" action="#hasil">
    <label for="nama-input" class="text-17 font-bold text-ink">Nama, satu per baris</label>
    <textarea
      id="nama-input"
      name="nama"
      rows="4"
      required
      autocomplete="off"
      spellcheck="false"
      aria-describedby="nama-hint"
      class="box-border min-h-[120px] w-full resize-y rounded-lg border-0 bg-white px-18 py-14 font-body text-18 shadow-[inset_0_0_0_1px_var(--color-chip-rule)] focus-visible:shadow-none leading-[1.5] text-ink"
      placeholder="Contoh: Muhammad Al Fatih"
    ></textarea>
    <p id="nama-hint" class="m-0 text-15 text-muted">Untuk banyak nama, salin satu kolom dari Excel lalu tempel di sini.</p>
    <div class="flex flex-wrap gap-12">
      <button type="submit" class="btn-primary cursor-pointer border-0 font-body">Ubah ke huruf Arab</button>
    </div>
  </form>

  <noscript>
    <p class="mt-16 rounded-lg bg-notice px-18 py-14 text-notice-ink">Halaman ini memerlukan JavaScript untuk mengubah nama.</p>
  </noscript>

  <section id="hasil" aria-labelledby="hasil-title" data-result hidden class="mt-48 scroll-mt-24 rounded-xl bg-sky-50 p-16 sm:p-28">
    <div class="flex flex-wrap items-center justify-between gap-12 px-4 pb-16">
      <div class="flex flex-col gap-2">
        <h2 id="hasil-title" class="m-0 text-34">Hasil</h2>
        <p data-status class="m-0 text-15 text-muted"></p>
      </div>
      <button type="button" data-copy-all class="btn-primary cursor-pointer font-body">
        <span data-icon aria-hidden="true"></span><span data-label>Salin semua</span>
      </button>
    </div>
    <ol data-list class="m-0 flex list-none flex-col gap-12 p-0"></ol>
    <p data-announce aria-live="polite" class="sr-only"></p>
  </section>

  <h2 id="cara">Cara penulisan</h2>
  <p>
    Nama yang sudah lazim dalam bahasa Arab, seperti Muhammad, ‘Aisyah, atau ‘Abdurrahman, ditulis dengan ejaan Arab
    bakunya. Nama lain ditulis menurut bunyinya: p menjadi <span lang="ar" dir="rtl">ف</span>, g menjadi <span lang="ar" dir="rtl">ج</span>, c menjadi <span lang="ar" dir="rtl">تش</span>, ng menjadi <span lang="ar" dir="rtl">نج</span>, dan akhiran
    -ah menjadi <span lang="ar" dir="rtl">ة</span>. Nama yang ditulis menurut bunyi ditandai, jadi periksa kembali sebelum dicetak, terutama untuk
    syahadah.
  </p>
  <p>Ada nama yang ejaannya kurang tepat? <a href={school.whatsapp.url}>Kabari kami lewat WhatsApp</a>.</p>
</ContentPage>

<script>
  import { toArabic } from '@/lib/nama-arab';

  const ICON = {
    copy: '<svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6.5" y="6.5" width="10" height="11" rx="2.5"/><path d="M13.5 6.5V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h1.5"/></svg>',
    done: '<svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5l4 3.8L16 6"/></svg>',
  };
  const form = document.querySelector<HTMLFormElement>('[data-nama]');
  const out = document.querySelector<HTMLElement>('[data-result]');
  if (form && out) {
    const input = form.querySelector('textarea') as HTMLTextAreaElement;
    const list = out.querySelector('[data-list]') as HTMLElement;
    const status = out.querySelector('[data-status]') as HTMLElement;
    const announce = out.querySelector('[data-announce]') as HTMLElement;
    const copyAll = out.querySelector('[data-copy-all]') as HTMLButtonElement;
    let results: string[] = [];

    // A copy button: an icon and a visible label. The label turns into
    // "Tersalin" for a moment, and the polite live region says what was copied.
    const setButton = (btn: HTMLButtonElement, icon: keyof typeof ICON, label: string) => {
      (btn.querySelector('[data-icon]') as HTMLElement).innerHTML = ICON[icon];
      (btn.querySelector('[data-label]') as HTMLElement).textContent = label;
    };
    const copy = async (text: string, btn: HTMLButtonElement, what: string) => {
      const label = btn.dataset.idle ?? '';
      try {
        await navigator.clipboard.writeText(text);
        setButton(btn, 'done', 'Tersalin');
        announce.textContent = `${what} tersalin.`;
      } catch {
        setButton(btn, 'copy', 'Gagal menyalin');
        announce.textContent = 'Gagal menyalin. Pilih tulisan Arabnya lalu salin secara manual.';
      }
      clearTimeout(Number(btn.dataset.timer));
      btn.dataset.timer = String(setTimeout(() => setButton(btn, 'copy', label), 2400));
    };
    const copyButton = (label: string, extra = '') => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-secondary ml-auto cursor-pointer font-body';
      btn.dataset.idle = label;
      btn.innerHTML = '<span data-icon aria-hidden="true"></span><span data-label></span>';
      if (extra) {
        const sr = document.createElement('span');
        sr.className = 'sr-only';
        sr.textContent = ` ${extra}`;
        btn.append(sr);
      }
      setButton(btn, 'copy', label);
      return btn;
    };
    copyAll.dataset.idle = 'Salin semua';
    setButton(copyAll, 'copy', 'Salin semua');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const names = input.value.split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
      if (!names.length) return input.focus();
      const items = names.map((n) => ({ latin: n, ...toArabic(n) }));
      results = items.map((it) => it.arabic);
      // One name gets the largest setting; a list stays scannable.
      const size = names.length === 1 ? 'text-[clamp(48px,9vw,80px)]' : 'text-[clamp(40px,6vw,56px)]';
      list.replaceChildren(
        ...items.map((it) => {
          const li = document.createElement('li');
          li.className = 'card flex flex-col gap-12 px-20 py-20 sm:px-32 sm:py-24';
          const latin = document.createElement('span');
          latin.className = 'text-16 font-bold text-muted';
          latin.textContent = it.latin;
          const ar = document.createElement('bdi');
          ar.lang = 'ar';
          ar.dir = 'rtl';
          ar.className = `block font-display leading-[1.5] text-ink [overflow-wrap:anywhere] ${size}`;
          ar.textContent = it.arabic;
          const foot = document.createElement('div');
          foot.className = 'flex flex-wrap items-center justify-between gap-x-16 gap-y-12';
          const note = document.createElement('p');
          note.className = 'm-0 flex max-w-[34em] items-start gap-8 text-15 leading-[1.5] text-body';
          if (it.bySound.length) {
            note.innerHTML = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="mt-2 flex-none"><circle cx="10" cy="10" r="7.5"/><path d="M10 6v5M10 13.6v.1"/></svg>';
            note.append(`Ditulis menurut bunyi: ${it.bySound.join(', ')}. Periksa sebelum dicetak.`);
          }
          const btn = copyButton('Salin', `tulisan Arab ${it.latin}`);
          btn.addEventListener('click', () => copy(it.arabic, btn, `Tulisan Arab ${it.latin}`));
          foot.append(note, btn);
          li.append(latin, ar, foot);
          return li;
        }),
      );
      status.textContent = names.length === 1 ? 'Satu nama diubah.' : `${names.length} nama diubah.`;
      announce.textContent = status.textContent;
      copyAll.hidden = names.length < 2;
      out.hidden = false;
      out.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });

    copyAll.addEventListener('click', () => copy(results.join('\n'), copyAll, `${results.length} nama`));
  }
</script>
