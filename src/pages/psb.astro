---
// /psb (design/Pendaftaran.dc.html): status per level, flow, waves, a fee
// comparison table, documents, FAQ (native <details>), contact. All from
// content/site.json; unknown values are hidden.
import TableScroll from '@/components/content/TableScroll.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Landscape from '@/components/home/Landscape.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { buildLevel } from '@/lib/level';
import { site, school, levels, known, numberWord, registerUrl, infoGroupUrl, type Level } from '@/lib/site';

type RawFee = { item: string; amount: number; label?: string; period?: string };
const rupiah = (n: number) => `Rp${n.toLocaleString('id-ID')}`;
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const year = known(site.psb.academicYear);

// Status list: open levels first, then the rest from the oldest level down.
const views = levels.map((l) => buildLevel(l));
const ordered = [...views.filter((v) => v.open), ...views.filter((v) => !v.open).reverse()];
const openViews = views.filter((v) => v.open);
// Phone action bar: one open level links straight to its form; several open
// levels go back to the status list to choose; none shows the info group.
const barAction =
  openViews.length === 1
    ? { href: registerUrl(openViews[0]!.level.slug), label: `Daftar ${openViews[0]!.level.name}` }
    : openViews.length > 1
      ? { href: '#p-status', label: 'Pilih jenjang dan daftar' }
      : { href: infoGroupUrl, label: 'Kabari saya' };

// Fee comparison: map each level's items onto four comparable columns.
const COLS = [
  { key: 'reg', label: 'Pendaftaran', match: /pendaftaran/i },
  { key: 'entry', label: 'Biaya masuk', match: /^(uang pangkal|daftar ulang)$/i },
  { key: 'yearly', label: 'Biaya tahunan', match: /tahunan/i },
  { key: 'spp', label: 'SPP', match: /^spp/i },
];
const feeRows = levels.map((l: Level) => {
  const fees = (l.fees ?? []) as RawFee[];
  const cell = (re: RegExp) => fees.find((f) => re.test(f.item));
  const cells = COLS.map((c) => cell(c.match));
  const free = l.feesNote && cells.slice(1, 3).every((f) => f && f.amount === 0);
  return { level: l, fees, cells, free };
});
const entryNotes = feeRows
  .map((r) => ({ name: r.level.name, item: r.cells[1] }))
  .filter((r) => r.item && r.item.amount > 0)
  .map((r) => `${r.name} sebagai ${lower(r.item!.item)}`);
const feeYears = levels
  .filter((l) => l.fees && known((l as Level & { feesYear?: string }).feesYear))
  .map((l) => `${l.name} untuk tahun ajaran ${(l as Level & { feesYear?: string }).feesYear}`);

const docs = site.psb.documents as Record<string, { items: string[]; note?: string } | string>;
const docLevels = levels.filter((l) => typeof docs[l.slug] === 'object');
const docHeading = ordered.find((v) => !docLevels.includes(v.level))?.level.name;
const faq = site.psb.faq.map((f) => ({
  q: f.q,
  a: f.a.replace('{ideal}', numberWord(school.halaqahRatio.ideal)).replace('{max}', numberWord(school.halaqahRatio.max)),
}));
const brochure = Object.entries(site.psb.brochures as Record<string, string | null>).find(([k, v]) => !k.startsWith('_') && v);

const h2 = 'm-0 font-display text-[clamp(40px,4.2vw,56px)] font-semibold leading-none';
const wrap = 'mx-auto box-border max-w-page px-20 py-64 sm:px-40 sm:py-80';
const th = 'px-16 pb-12 text-14 font-medium text-muted';
const td = 'px-16 py-18';
---
<BaseLayout title="Pendaftaran santri baru" description="Status pendaftaran, alur, biaya per jenjang, dan berkas yang disiapkan untuk mendaftar di Ma’had Tahfizh Al Yusro." footerLabelledBy="g-foot-title">
  <PageHeader
    id="p-title"
    title="Pendaftaran santri baru"
    lede="Pendaftaran dilakukan online, lalu tes masuk langsung di ma’had. Mulai dari jenjang yang sesuai usia anak."
    crumbs={[{ label: 'Pendaftaran' }]}
    photo={{ name: 'santri-putri-ujian', width: 1600, height: 1068, alt: 'Santri putri bercadar mengerjakan soal ujian di meja kelas' }}
    photoFirst={false}
  >
    <section aria-labelledby="p-status" class="mt-8 w-full" data-psb-status>
      <h2 id="p-status" class="m-0 mb-12 text-15 font-bold text-muted">
        Status pendaftaran per jenjang{year ? `, tahun ajaran ${year}` : ''}
      </h2>
      <ul class="@container m-0 flex list-none flex-col gap-8 p-0">
        {
          ordered.map((v) => (
            <li class="card flex flex-wrap items-center gap-x-16 gap-y-10 px-16 py-12 @[520px]:flex-nowrap @[520px]:px-20">
              <span class="flex min-w-0 flex-[1_1_0] flex-col">
                <span class="font-display text-[26px] font-semibold leading-[1.1]">{v.level.name}</span>
                <span class="text-14 text-muted">{v.level.setara}</span>
              </span>
              <StatusBadge open={v.open} class="w-[136px] flex-none" />
              {/* Same width on every row once the list is wide enough, so the badges line up in one column. */}
              <span class:list={['flex-none basis-full @[520px]:basis-auto @[520px]:w-[176px]', !v.open && 'hidden @[520px]:block']}>
                {v.open && <a href={registerUrl(v.level.slug)} class="btn-primary min-h-44 w-full px-18 text-15">Daftar {v.level.name}</a>}
              </span>
            </li>
          ))
        }
      </ul>
    </section>
    <ul class="m-0 flex list-none flex-col gap-4 p-0 text-15 text-muted">
      {
        views.some((v) => !v.open) && (
          <li>Jenjang yang belum dibuka: <a href={infoGroupUrl} class="font-bold">kabari saya lewat grup info saat dibuka</a></li>
        )
      }
      <li>Ada pertanyaan sebelum mendaftar? <a href={school.whatsapp.url} class="font-bold">Tanya tim pendaftaran lewat WhatsApp</a></li>
    </ul>
  </PageHeader>

  <section aria-labelledby="p-alur" class="bg-white">
    <div class={wrap}>
      <h2 id="p-alur" class:list={[h2, 'mb-12']}>Alur pendaftaran</h2>
      <p class="m-0 mb-36 max-w-[40em] text-body">Berlaku untuk semua jenjang. Ma’had ‘Aly memakai akun pendaftaran tersendiri dan berkasnya diverifikasi panitia sebelum tes.</p>
      <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(230px,100%),1fr))] gap-24 p-0">
        {
          [
            ['Isi formulir online', 'Buat akun, isi data santri, dan unggah berkas.'],
            ['Bayar biaya pendaftaran', 'Transfer ke rekening yayasan. Besarnya berbeda per jenjang, lihat tabel biaya.'],
            ['Ikuti tes masuk di ma’had', 'Tes dilaksanakan langsung di Tenjolaya sesuai gelombang yang dipilih.'],
            ['Daftar ulang', 'Setelah dinyatakan diterima, selesaikan daftar ulang sebelum tahun ajaran dimulai.'],
          ].map(([t, d], i) => (
            <li class="flex flex-col gap-8 rounded-lg bg-paper p-20 sm:p-24">
              <span aria-hidden="true" class="font-display text-[44px] leading-[0.9] text-lapis">{i + 1}</span>
              <strong>{t}</strong>
              <span class="text-15 text-body">{d}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    views
      .filter((v) => v.open)
      .map((v) => (
        <section aria-labelledby={`p-gelombang-${v.level.slug}`}>
          <div class:list={[wrap, 'flex flex-wrap gap-x-64 gap-y-32']}>
            <div class="max-w-[420px] flex-[1_1_300px]">
              <h2 id={`p-gelombang-${v.level.slug}`} class:list={[h2, 'mb-12']}>Gelombang {v.level.name}</h2>
              <p class="m-0 text-body">
                {year ? `Tahun ajaran ${year}. ` : ''}Gelombang yang sudah lewat otomatis disembunyikan.
              </p>
            </div>
            <div class="min-w-0 flex-[1.4_1_480px]">
              {v.wavesAnnounced ? (
                <TableScroll labelledby={`cap-gelombang-${v.level.slug}`}>
                <table class="w-full min-w-[420px]">
                  <caption id={`cap-gelombang-${v.level.slug}`} class="sr-only">Jadwal gelombang pendaftaran {v.level.name}</caption>
                  <thead>
                    <tr>
                      {['Gelombang', 'Pendaftaran dibuka', 'Tes masuk'].map((h) => (
                        <th scope="col" class:list={[th, 'text-left']}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {v.waves.map((w) => (
                      <tr>
                        <th scope="row" class:list={[td, 'text-left']}>{w.name}</th>
                        <td class={td}>{w.opens ?? 'Segera diumumkan'}</td>
                        <td class={td}>{w.test ?? 'Segera diumumkan'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                </TableScroll>
              ) : (
                <p class="card m-0 px-20 py-16 text-body">
                  Jadwal gelombang dan tes masuk belum diumumkan.{' '}
                  <a href={school.whatsapp.url} class="font-bold">Tanyakan lewat WhatsApp</a>
                </p>
              )}
            </div>
          </div>
        </section>
      ))
  }

  <section aria-labelledby="p-biaya" class="bg-white">
    <div class={wrap}>
      <h2 id="p-biaya" class:list={[h2, 'mb-12']}>Biaya per jenjang</h2>
      <p class="m-0 mb-32 max-w-[42em] text-body">Satu tabel untuk membandingkan. Jenjang yang rinciannya belum dipublikasikan bisa ditanyakan lewat WhatsApp.</p>
      <p class="m-0 mb-12 text-14 text-muted lg:hidden" aria-hidden="true">Geser tabel ke samping untuk melihat semua kolom.</p>
      <TableScroll labelledby="cap-biaya" sticky surface="white">
        <table class="w-full min-w-[820px] tabular-nums [--stripe:var(--color-paper)]">
          <caption id="cap-biaya" class="sr-only">Perbandingan biaya per jenjang</caption>
          <thead>
            <tr>
              <th scope="col" class:list={[th, 'pr-16 text-left']}>Jenjang</th>
              {COLS.map((c, i) => <th scope="col" class:list={[th, 'text-right', i === COLS.length - 1 ? 'pl-16' : 'px-16']}>{c.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              feeRows.map((r) => (
                <tr>
                  <th scope="row" class:list={[td, 'pr-16 text-left']}>{r.level.name}</th>
                  {r.fees.length === 0 ? (
                    <td colspan={COLS.length} class:list={[td, 'pl-16 text-right text-muted']}>
                      Belum dipublikasikan. <a href={school.whatsapp.url} class="font-bold">Tanya biaya</a>
                    </td>
                  ) : r.free ? (
                    <>
                      <td class:list={[td, 'px-16 text-right font-bold']}>{r.cells[0] ? rupiah(r.cells[0].amount) : '–'}</td>
                      <td colspan={COLS.length - 1} class:list={[td, 'pl-16 text-right font-bold text-lapis']}>{r.level.feesNote?.replace(/\.$/, '')}</td>
                    </>
                  ) : (
                    r.cells.map((f, i) => (
                      <td class:list={[td, 'text-right', i === COLS.length - 1 ? 'pl-16' : 'px-16', f ? 'font-bold' : 'text-muted']}>
                        {f ? (f.amount === 0 && f.label ? f.label : rupiah(f.amount)) : 'Belum dipublikasikan'}
                        {f && known(f.period) && <span class="font-normal text-muted"> {f.period}</span>}
                      </td>
                    ))
                  )}
                </tr>
              ))
            }
          </tbody>
        </table>
      </TableScroll>
      {
        (feeYears.length > 0 || entryNotes.length > 0) && (
          <p class="m-0 mt-16 text-14 text-muted">
            {feeYears.length > 0 && `Biaya ${feeYears.join(', ')}. `}
            {entryNotes.length > 0 && `Biaya masuk ${entryNotes.join(', ')}.`}
          </p>
        )
      }
    </div>
  </section>

  <section aria-labelledby="p-berkas">
    <div class={wrap}>
      <h2 id="p-berkas" class:list={[h2, 'mb-32']}>Berkas yang disiapkan</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(380px,100%),1fr))] items-start gap-16">
        <div class="card p-24 sm:p-28">
          <h3 class="m-0 mb-8 text-18">{docHeading ? `${docHeading} dan jenjang lain` : 'Jenjang lain'}</h3>
          <p class="m-0 text-body">
            Daftar berkas diumumkan panitia saat pendaftaran dibuka. <a href={school.whatsapp.url} class="font-bold">Tanyakan lewat WhatsApp</a>
          </p>
        </div>
        {
          docLevels.map((l) => {
            const d = docs[l.slug] as { items: string[]; note?: string };
            return (
              <div class="card p-24 sm:p-28">
                <h3 class="m-0 mb-8 text-18">{l.name}</h3>
                <ul class="m-0 flex flex-col gap-4 pl-20 text-body">
                  {d.items.map((it) => <li>{it}</li>)}
                </ul>
                {d.note && <p class="m-0 mt-12 text-15 text-muted">{d.note}</p>}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="p-faq" class="bg-white">
    <div class:list={[wrap, 'flex flex-wrap gap-x-64 gap-y-32']}>
      <h2 id="p-faq" class:list={[h2, 'max-w-[420px] flex-[1_1_300px]']}>Pertanyaan yang sering diajukan</h2>
      <div class="flex min-w-0 flex-[1.4_1_480px] flex-col gap-8">
        {
          faq.map((f) => (
            <details class="group rounded-lg bg-paper px-20 sm:px-24">
              <summary class="flex min-h-64 cursor-pointer items-center justify-between gap-16 font-bold transition-colors duration-150 hover:text-lapis">
                {f.q}
                <span aria-hidden="true" class="text-[24px] font-normal transition-transform duration-150 group-open:rotate-45">+</span>
              </summary>
              <p class="m-0 mb-20 text-body">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-label="Kontak pendaftaran" class="bg-ink text-on-night">
    <div class="mx-auto box-border flex max-w-page flex-wrap items-center justify-between gap-x-48 gap-y-24 px-20 py-56 sm:px-40 sm:py-64">
      <p class="m-0 max-w-[18em] font-display text-[clamp(32px,3.4vw,44px)] font-semibold leading-[1.05] text-white">Masih ragu memilih jenjang? Tanyakan langsung.</p>
      <div class="flex flex-wrap gap-12">
        <a href={school.whatsapp.url} class="btn-light">WhatsApp {school.whatsapp.display}</a>
        {brochure && <a href={brochure[1]!} class="btn-ghost-night">Unduh brosur {levels.find((l) => l.slug === brochure[0])?.name} (PDF)</a>}
      </div>
    </div>
  </section>

  <nav aria-label="Aksi pendaftaran" data-psb-bar class="psb-bar glass-paper fixed inset-x-0 bottom-0 z-[4] lg:hidden">
    <div class="mx-auto box-border flex max-w-page gap-8 px-16 py-10 pb-[max(10px,env(safe-area-inset-bottom))]">
      <a href={barAction.href} class="btn-primary min-h-48 flex-[1_1_0] px-16 text-15">{barAction.label}</a>
      <a href={school.whatsapp.url} class="btn-secondary min-h-48 flex-none px-18 text-15">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z"></path></svg>
        WhatsApp
      </a>
    </div>
  </nav>

  <Landscape slot="footer-lead" />
</BaseLayout>

<style>
  /* Phone action bar: hidden (and out of the tab order) until the status
     list has scrolled away; hidden again once the closing landscape, which
     has the same actions, comes into view. */
  .psb-bar {
    visibility: hidden;
    transform: translateY(100%);
    transition: transform 200ms ease-out, visibility 0s linear 200ms;
    box-shadow: 0 -8px 24px -16px rgb(27 34 53 / 0.35);
  }
  .psb-bar[data-show] {
    visibility: visible;
    transform: none;
    transition: transform 200ms ease-out;
  }
  /* Focused elements scroll clear of the bar. */
  @media (max-width: 1023px) {
    :global(html:has(.psb-bar[data-show])) { scroll-padding-bottom: 88px; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-psb-bar]');
  const status = document.querySelector('[data-psb-status]');
  const end = document.querySelector('footer');
  if (bar && status && 'IntersectionObserver' in window) {
    let past = false;
    let atEnd = false;
    const update = () => bar.toggleAttribute('data-show', past && !atEnd);
    new IntersectionObserver(([e]) => {
      past = !e!.isIntersecting && e!.boundingClientRect.top < 0;
      update();
    }).observe(status);
    if (end) new IntersectionObserver(([e]) => { atEnd = e!.isIntersecting; update(); }).observe(end);
  }
</script>
