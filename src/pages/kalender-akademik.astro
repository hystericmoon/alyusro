---
// /kalender-akademik: the academic calendar from site.json. While it is
// current, past events are muted; once its last date has passed, one line
// says the year has ended.
import TableScroll from '@/components/content/TableScroll.astro';
import ContentPage from '@/components/content/ContentPage.astro';
import { site } from '@/lib/site';

type Ev = { start: string; end?: string; label: string };
const cal = site.academicCalendar as { year: string; events: Ev[] };
const MONTHS = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
const parts = (s: string) => s.split('-').map(Number) as [number, number, number];
const fmt = (s: string) => {
  const [y, m, d] = parts(s);
  return `${d} ${MONTHS[m - 1]} ${y}`;
};
const range = (e: Ev) => {
  if (!e.end) return fmt(e.start);
  const [y1, m1, d1] = parts(e.start);
  const [y2, m2] = parts(e.end);
  if (y1 === y2 && m1 === m2) return `${d1}–${fmt(e.end)}`;
  if (y1 === y2) return `${d1} ${MONTHS[m1 - 1]} – ${fmt(e.end)}`;
  return `${fmt(e.start)} – ${fmt(e.end)}`;
};
const last = cal.events.map((e) => e.end || e.start).sort().at(-1) ?? '';
const today = new Date().toISOString().slice(0, 10);
const current = last >= today;
---
<ContentPage
  closing="compact"
  title="Kalender akademik"
  lede="Jadwal kegiatan belajar, ujian, libur, dan kedatangan santri sepanjang tahun ajaran."
  crumbs={[{ label: 'Kurikulum' }, { label: 'Kalender akademik' }]}
>
  <h2 style="margin-top:0">Tahun ajaran {cal.year}</h2>
  {!current && <p>Tahun ajaran ini sudah berakhir.</p>}
  <TableScroll labelledby="cap-kalender">
  <table>
    <caption id="cap-kalender" class="sr-only">Kalender akademik {cal.year}</caption>
    <thead><tr><th scope="col">Tanggal</th><th scope="col">Kegiatan</th></tr></thead>
    <tbody>
      {cal.events.map((e) => (
        <tr class:list={[current && (e.end || e.start) < today && 'text-muted']}>
          <td class="w-[42%] sm:w-auto sm:whitespace-nowrap">{range(e)}</td>
          <td>{e.label}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </TableScroll>
</ContentPage>
