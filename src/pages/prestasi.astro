---
// /prestasi: totals and a few highlights from content/prestasi.json, the
// totals by competition and level, then every achievement by name and year
// (the school consented to publishing names). Older years are collapsed.
import { getCollection } from 'astro:content';
import TableScroll from '@/components/content/TableScroll.astro';
import ContentPage from '@/components/content/ContentPage.astro';
import { summary, records, highlights } from '@/lib/prestasi';

const s = summary();
const articles = (await getCollection('artikel', (a) => !a.data.draft && a.data.category === 'Prestasi')).map((a) => ({
  id: a.id,
  title: a.data.title,
  year: a.data.date.getFullYear(),
  body: a.body ?? '',
}));
const top = highlights(articles);
const byYear = [...new Set(records.map((r) => String(r.year)))]
  .sort((a, b) => Number(b) - Number(a))
  .map((year) => ({ year, rows: records.filter((r) => String(r.year) === year) }));
const span = `${Math.min(...s.years)}–${Math.max(...s.years)}`;
---
<ContentPage
  title="Prestasi"
  lede={`${s.total} prestasi santri dan asatidz dalam lomba tahfizh, bahasa Arab, dan lainnya, ${span}.`}
  crumbs={[{ label: 'Profil' }, { label: 'Prestasi' }]}
  toc={[
    { id: 'ringkasan', text: 'Ringkasan' },
    ...(top.length ? [{ id: 'sorotan', text: 'Sorotan' }] : []),
    { id: 'per-lomba', text: 'Per jenis lomba' },
    { id: 'per-tingkat', text: 'Per tingkat' },
    { id: 'daftar', text: 'Daftar lengkap' },
  ]}
>
  <h2 id="ringkasan" class="sr-only">Ringkasan</h2>
  <dl class="not-prose m-0 grid grid-cols-[repeat(auto-fit,minmax(min(200px,100%),1fr))] gap-16">
    {
      [
        [String(s.total), 'prestasi tercatat'],
        [String(s.nationalFirsts), 'juara pertama tingkat nasional'],
        [String(s.byFamily[0]?.total ?? 0), s.byFamily[0]?.family ?? ''],
      ].map(([n, label]) => (
        <div class="card flex flex-col-reverse gap-4 p-20 sm:p-24">
          <dt class="text-15 text-body">{label}</dt>
          <dd class="m-0 font-display text-[56px] font-semibold leading-none text-lapis">{n}</dd>
        </div>
      ))
    }
  </dl>

  {
    top.length > 0 && (
      <>
        <h2 id="sorotan">Sorotan</h2>
        <ul class="not-prose m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-16 p-0">
          {top.map((h) => (
            <li class="card flex flex-col gap-14 p-20 sm:p-24">
              <p class="m-0 flex flex-wrap gap-x-12 text-14 font-bold">
                <span class="text-lapis">{h.scope === 'Internasional' ? 'Internasional' : 'Nasional'}</span>
                <span class="text-muted">{h.year}</span>
              </p>
              <h3 class="m-0 font-display text-[30px] font-semibold leading-[1.05] [text-wrap:balance]">{h.competition}</h3>
              <ul class="m-0 flex list-none flex-col gap-8 p-0 text-16 leading-[1.4]">
                {h.entries.map((e) => (
                  <li>
                    <span class="block font-bold text-ink">{e.name}</span>
                    <span class="text-15 text-body">{e.rank}{e.stage && ` · ${e.stage}`}</span>
                  </li>
                ))}
              </ul>
              <p class="m-0 mt-auto text-15 text-muted">{h.organizer}</p>
              {h.article && (
                <a href={h.article.href} class="-my-8 inline-flex min-h-44 items-center self-start text-15 font-bold">
                  Baca kabarnya<span class="sr-only">: {h.article.title}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2 id="per-lomba">Per jenis lomba</h2>
  <TableScroll labelledby="cap-per-lomba" sticky>
    <table class="min-w-[560px]">
      <caption id="cap-per-lomba" class="sr-only">Jumlah prestasi per jenis lomba dan tahun</caption>
      <thead>
        <tr>
          <th scope="col">Jenis lomba</th>
          {s.years.map((y) => <th scope="col" class="text-right">{y}</th>)}
          <th scope="col" class="text-right">Total</th>
        </tr>
      </thead>
      <tbody>
        {
          s.byFamily.map((f) => (
            <tr>
              <th scope="row">{f.family}</th>
              {f.perYear.map((n) => <td class:list={['text-right', n === 0 && 'text-muted']}>{n || '–'}</td>)}
              <td class="text-right font-bold">{f.total}</td>
            </tr>
          ))
        }
        <tr>
          <th scope="row">Semua lomba</th>
          {s.yearTotals.map((n) => <td class="text-right font-bold">{n}</td>)}
          <td class="text-right font-bold">{s.total}</td>
        </tr>
      </tbody>
    </table>
  </TableScroll>

  <h2 id="per-tingkat">Per tingkat</h2>
  <TableScroll labelledby="cap-per-tingkat">
  <table>
    <caption id="cap-per-tingkat" class="sr-only">Jumlah prestasi per tingkat lomba</caption>
    <thead><tr><th scope="col">Tingkat</th><th scope="col" class="text-right">Prestasi</th></tr></thead>
    <tbody>
      {s.scopes.map((x) => (
        <tr>
          <th scope="row">{x.scope}</th>
          <td class="text-right">{x.total}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </TableScroll>

  <h2 id="daftar">Daftar lengkap</h2>
  <p>Kabar lomba terbaru ada di <a href="/artikel/">Kajian &amp; artikel</a>.</p>
  {
    byYear.map((y, i) => {
      const table = (
        <TableScroll labelledby={`cap-tahun-${y.year}`} sticky surface={i === 0 ? 'paper' : 'white'} class={i === 0 ? undefined : 'mb-20 [--stripe:var(--color-paper)]'}>
          <table class="min-w-[720px]">
            <caption id={`cap-tahun-${y.year}`} class="sr-only">Daftar prestasi tahun {y.year}</caption>
            <thead>
              <tr>
                <th scope="col">Nama</th>
                <th scope="col">Peringkat</th>
                <th scope="col">Lomba</th>
                <th scope="col">Tingkat</th>
                <th scope="col">Penyelenggara</th>
              </tr>
            </thead>
            <tbody>
              {y.rows.map((r) => (
                <tr>
                  <th scope="row">{r.name}</th>
                  <td class="whitespace-nowrap">{r.rank}</td>
                  <td>{r.competition}</td>
                  <td>{r.level || '–'}</td>
                  <td>{r.organizer || '–'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </TableScroll>
      );
      return i === 0 ? (
        <>
          <h3 id={`tahun-${y.year}`}>{y.year} <span class="font-normal text-muted">· {y.rows.length} prestasi</span></h3>
          {table}
        </>
      ) : (
        <details id={`tahun-${y.year}`} class="card group mb-12 px-20 sm:px-24">
          <summary class="flex min-h-56 cursor-pointer items-center justify-between gap-16 text-18 font-bold">
            <span>{y.year} <span class="font-normal text-muted">· {y.rows.length} prestasi</span></span>
            <span aria-hidden="true" class="text-[24px] font-normal transition-transform duration-150 group-open:rotate-45">+</span>
          </summary>
          {table}
        </details>
      );
    })
  }
</ContentPage>
