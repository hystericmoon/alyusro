---
// Gunung Salak landscape: lead of every page's footer and the site's closing
// call to action. `.sky` tints it by time of day; LivingSky.astro (homepage
// only) sets data-sky and moves the sun. Without that script it stays the
// designed day. The campus photo (the school's own, from its Instagram)
// stays mostly in view: the frosted "Mulai dari sini" panel (the three next
// steps a parent actually takes: ask, read the details, visit) sits below it
// on phones and tablets and overlaps only its bottom edge from 1024px.
import StarField from '@/components/StarField.astro';
import { school, levels, registerUrl, numberWord, openLevels } from '@/lib/site';
import { upcomingWaves } from '@/lib/level';

const ideal = numberWord(school.halaqahRatio.ideal);
const open = openLevels().map((l) => l.name);
const openText =
  open.length === 0 ? null : open.length === 1 ? open[0] : `${open.slice(0, -1).join(', ')} dan ${open[open.length - 1]}`;
// "Jadwal" only while /psb has a wave table to show.
const hasWaves = levels.some((l) => upcomingWaves(l.slug).some((w) => w.opens || w.test));
const onPsb = Astro.url.pathname.replace(/\/$/, '') === '/psb';
const steps = [
  { title: 'Tanya tim pendaftaran', note: 'WhatsApp', number: school.whatsapp.display, href: school.whatsapp.url },
  onPsb
    ? { title: 'Bandingkan jenjang', note: 'Usia, target hafalan, dan program', href: '/#jenjang' }
    : hasWaves
      ? { title: 'Lihat biaya dan jadwal', note: 'Alur, gelombang, dan berkas', href: '/psb/' }
      : { title: 'Lihat biaya dan alur', note: 'Alur pendaftaran, biaya, dan berkas', href: '/psb/' },
  { title: 'Datang ke Tenjolaya', note: 'Buka peta lokasi', href: school.mapsUrl },
];
---
<div data-landscape data-sky="day" class="sky relative overflow-hidden pb-[270px] sm:pb-[300px]">
  <StarField count={48} seed={11} class="inset-x-0 top-0 h-[62%]" />
  <div class="relative z-[1] mx-auto box-border grid max-w-page items-end gap-x-64 gap-y-40 px-20 pt-72 sm:px-40 sm:pt-96 lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)]">
    <div class="flex max-w-[720px] flex-col items-start gap-22">
      {
        openText && (
          <p class="cta-badge m-0 inline-flex items-center gap-8 rounded-full px-12 py-4 text-14 font-bold">
            <span aria-hidden="true" class="size-8 flex-none rounded-full bg-[var(--panel-num)]"></span>
            Pendaftaran {openText} dibuka
          </p>
        )
      }
      <h2 id="g-foot-title" class="m-0 font-display text-[clamp(44px,5.2vw,76px)] font-semibold leading-[0.98] [text-wrap:balance]">
        Belajar dan menghafal di kaki Gunung Salak
      </h2>
      <p class="m-0 max-w-[33em] text-18 text-[var(--land-body)] [text-wrap:pretty]">
        Udara sejuk, jauh dari keramaian kota. Santri tinggal di ma’had dan menyetorkan hafalan setiap hari dalam
        halaqah kecil, idealnya {ideal} santri untuk satu muhaffizh.
      </p>
      <a href={registerUrl()} class="btn-primary">Daftar santri baru</a>
    </div>
    <div class="relative">
      <picture>
        <source type="image/webp" srcset="/photos/kampus-gunung-salak-800.webp 800w, /photos/kampus-gunung-salak-1600.webp 1600w" sizes="(min-width: 1024px) 560px, 100vw" />
        <img
          src="/photos/kampus-gunung-salak-1600.jpg"
          width="1600"
          height="819"
          loading="lazy"
          decoding="async"
          alt="Kampus Ma’had Tahfizh Al Yusro dilihat dari udara: gedung asrama dan kelas, lapangan, dan Gunung Salak di belakangnya"
          class="block aspect-[16/11] w-full rounded-xl object-cover"
        />
      </picture>
      <nav aria-labelledby="g-foot-steps" class="cta-panel relative mt-12 rounded-lg p-8 lg:mx-24 lg:-mt-56">
        <p id="g-foot-steps" class="m-0 px-16 pb-4 pt-12 text-14 font-bold text-[var(--panel-muted)]">Mulai dari sini</p>
        <ol class="m-0 flex list-none flex-col gap-2 p-0">
          {
            steps.map((s, i) => (
              <li>
                <a href={s.href} class="cta-step group flex min-h-64 items-center gap-12 sm:gap-16 rounded-md px-16 py-12 text-[var(--land-ink)] no-underline">
                  <span aria-hidden="true" class="inline-flex size-36 flex-none items-center justify-center rounded-full bg-[var(--panel-chip)] font-display text-22 font-semibold leading-none text-[var(--panel-num)]">{i + 1}</span>
                  <span class="flex min-w-0 flex-1 flex-col">
                    <span class="text-17 font-bold leading-[1.3]">{s.title}</span>
                    <span class="text-15 leading-[1.4] text-[var(--panel-muted)]">
                      {s.note}{'number' in s && <> <span class="whitespace-nowrap">{s.number}</span></>}
                    </span>
                  </span>
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="cta-arrow flex-none"><path d="M4 10h12M11 5l5 5-5 5"></path></svg>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </div>
  <svg aria-hidden="true" viewBox="0 0 1440 460" preserveAspectRatio="xMidYMax slice" class="absolute bottom-0 left-0 block h-[300px] w-full sm:h-[380px]">
    <g data-sun><circle cx="0" cy="0" r="46" class="fill-amber stroke-[var(--color-amber-edge)]" stroke-width="3"></circle></g>
    <path data-hill class="fill-[var(--h1)]" d="M0 300 C 160 282 320 246 470 200 C 580 166 660 126 728 96 C 760 82 784 64 806 60 C 826 57 842 70 860 86 C 878 102 896 112 914 106 C 936 98 952 80 974 76 C 996 72 1018 90 1046 116 C 1104 168 1190 214 1290 244 C 1350 262 1400 272 1440 276 L 1440 460 L 0 460 Z"></path>
    <path class="fill-[var(--h2)]" d="M0 352 C 110 334 220 318 330 322 C 450 326 540 296 650 288 C 760 280 850 312 960 306 C 1070 300 1170 270 1270 272 C 1350 274 1405 286 1440 292 L 1440 460 L 0 460 Z"></path>
    <path class="fill-[var(--h3)]" d="M0 394 C 130 368 250 366 370 380 C 500 396 620 354 760 358 C 880 362 970 396 1090 390 C 1210 384 1320 352 1440 358 L 1440 460 L 0 460 Z"></path>
    <path class="fill-[var(--h4)]" d="M0 428 C 180 404 340 410 500 420 C 690 432 860 398 1050 404 C 1210 409 1340 424 1440 420 L 1440 460 L 0 460 Z"></path>
    <path class="fill-ink" d="M0 452 C 220 440 420 444 640 450 C 860 456 1080 440 1300 444 C 1370 446 1410 448 1440 448 L 1440 460 L 0 460 Z"></path>
  </svg>
</div>
