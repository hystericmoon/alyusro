---
// Hafalan map with class filter: plain HTML and a small script, no framework.
// Filter buttons use aria-pressed; the readout is aria-live="polite".
import type { JuzClass } from '@/lib/juz-map';

interface Props {
  ariaLabel: string;
  classes: JuzClass[];
  readouts: Record<string, string>;
}
const { ariaLabel, classes, readouts } = Astro.props;

// One lapis step per class, in hafalan order (VII → XI).
const TONES = [
  { cell: 'bg-lapis-1 text-ink', swatch: 'bg-lapis-1 shadow-[inset_0_0_0_1px_rgb(27_34_53/0.3)]' },
  { cell: 'bg-lapis-2 text-ink', swatch: 'bg-lapis-2 shadow-[inset_0_0_0_1px_rgb(27_34_53/0.3)]' },
  { cell: 'bg-lapis-3 text-ink', swatch: 'bg-lapis-3 shadow-[inset_0_0_0_1px_rgb(27_34_53/0.3)]' },
  { cell: 'bg-lapis-4 text-white', swatch: 'bg-lapis-4 shadow-[inset_0_0_0_1px_rgb(27_34_53/0.3)]' },
  { cell: 'bg-lapis-5 text-white', swatch: 'bg-lapis-5 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.5)]' },
];
const classOf = new Map<number, number>();
classes.forEach((c, i) => c.juz.forEach((n) => classOf.set(n, i)));
const chip =
  'inline-flex cursor-pointer items-center gap-8 rounded-full border-0 bg-paper px-16 min-h-44 font-body text-15 font-bold leading-[1.2] text-ink transition-[background-color,color,transform] duration-150 hover:bg-lapis-1 active:scale-[0.97] aria-pressed:bg-ink aria-pressed:text-white';
---
<div data-juz-map data-readouts={JSON.stringify(readouts)} class="flex flex-col gap-20">
  <div data-juz-grid data-motion="pending" role="img" aria-label={ariaLabel} class="grid grid-cols-5 gap-6 sm:grid-cols-10">
    {
      Array.from({ length: 30 }, (_, i) => i + 1).map((n) => {
        const tone = classOf.get(n);
        return (
          <div
            data-juz-cell={n}
            data-class={tone !== undefined ? classes[tone]?.key : undefined}
            data-off={tone === undefined ? '' : undefined}
            class:list={[
              'flex aspect-square items-center justify-center rounded-sm text-16 font-bold tabular-nums',
              'transition-[background-color,color,transform] duration-200 data-[off]:bg-juz-off data-[off]:text-juz-off-ink data-[preview]:-translate-y-2',
              tone !== undefined ? TONES[tone]?.cell : '',
            ]}
          >
            {n}
          </div>
        );
      })
    }
  </div>

  <div role="group" aria-label="Pilih kelas" class="flex flex-wrap gap-8">
    <button type="button" data-pick="all" aria-pressed="true" class={chip}>Semua kelas</button>
    {
      classes.map((c, i) => (
        <button type="button" data-pick={c.key} data-juz={c.juz.join(',')} aria-pressed="false" class={chip}>
          <span aria-hidden="true" class:list={['size-12 flex-none', TONES[i]?.swatch]} />
          {c.label} <span class="font-normal">juz {c.range}</span>
        </button>
      ))
    }
  </div>

  <p data-juz-readout aria-live="polite" class="m-0 display-text min-h-[2.6em] font-display text-22 text-ink sm:text-25 [text-wrap:pretty]">
    {readouts.all}
  </p>
</div>

<script>
  import { cssVar, loadGsap, onceInView, prefersReducedMotion } from '@/lib/motion';

  const root = document.querySelector<HTMLElement>('[data-juz-map]');
  const grid = root?.querySelector<HTMLElement>('[data-juz-grid]');
  if (root && grid) {
    const readouts = JSON.parse(root.dataset.readouts ?? '{}') as Record<string, string>;
    const readout = root.querySelector<HTMLElement>('[data-juz-readout]')!;
    const cells = Array.from(grid.querySelectorAll<HTMLElement>('[data-juz-cell]'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pick]'));
    let finishIntro: (() => void) | null = null;

    const select = (key: string) => {
      finishIntro?.(); // a click ends the intro at its final state
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pick === key)));
      cells.forEach((c) => c.toggleAttribute('data-off', !c.dataset.class || (key !== 'all' && c.dataset.class !== key)));
      readout.textContent = readouts[key] ?? '';
    };
    // Micro-interaction: hovering or focusing a class chip lifts that class's cells.
    const preview = (key: string | null) =>
      cells.forEach((c) => c.toggleAttribute('data-preview', key !== null && key !== 'all' && c.dataset.class === key));

    buttons.forEach((b) => {
      const key = b.dataset.pick ?? 'all';
      b.addEventListener('click', () => select(key));
      b.addEventListener('pointerenter', () => preview(key));
      b.addEventListener('pointerleave', () => preview(null));
      b.addEventListener('focus', () => preview(key));
      b.addEventListener('blur', () => preview(null));
    });

    // Motion moment 1: the map fills in class order the first time it is in view.
    if (prefersReducedMotion() || !document.documentElement.classList.contains('motion-ok')) {
      grid.dataset.motion = 'done';
    } else {
      onceInView(grid, async () => {
        const gsap = await loadGsap();
        const byJuz = new Map(cells.map((c) => [c.dataset.juzCell, c]));
        const off = cssVar('--color-juz-off', '#EEF0F4');
        const offInk = cssVar('--color-juz-off-ink', '#5B6374');
        const lit = cells.filter((c) => c.dataset.class);
        gsap.set(lit, { transition: 'none' });
        // Lift the CSS gate and start the timeline in the same task, so the
        // filled colours never paint before the `from` values apply.
        grid.dataset.motion = 'done';
        const tl = gsap.timeline({
          onComplete: () => {
            gsap.set(lit, { clearProps: 'backgroundColor,color,transition' });
            finishIntro = null;
          },
        });
        buttons.filter((b) => b.dataset.juz).forEach((b, i) => {
          // Cells in hafalan order within the class (e.g. 30, 29, … 26).
          const group = (b.dataset.juz ?? '').split(',').map((n) => byJuz.get(n)).filter((c): c is HTMLElement => !!c);
          tl.from(group, { backgroundColor: off, color: offInk, duration: 0.32, stagger: 0.05, ease: 'power1.out' }, i === 0 ? 0 : '-=0.12');
        });
        finishIntro = () => tl.progress(1);
      });
    }
  }
</script>
