---
// Section 1: hafalan map hero. The map itself is the JuzMap island.
// From 1280px the right column is a campus photo with the juz map card
// overlapping its lower part; below that the photo comes first (CSS order,
// so the reading and focus order stay text first), then the text, then the map.
import JuzMap from '@/components/home/JuzMap.astro';
import { buildJuzMap } from '@/lib/juz-map';
import { latestTop } from '@/lib/prestasi';
import { school, openLevels, registerUrl, infoGroupUrl } from '@/lib/site';

const map = buildJuzMap();
const open = openLevels();
const openNames = open.map((l) => `${l.name} (${l.setara.charAt(0).toLowerCase()}${l.setara.slice(1)})`).join(', ');
const primaryOpen = open[0];
const proof = latestTop();
---
<section
  aria-labelledby="g-hero-title"
  class="mx-auto box-border flex max-w-page flex-col gap-40 px-20 pb-96 pt-24 sm:px-40 sm:pt-40 xl:grid xl:grid-cols-[minmax(0,1fr)_minmax(0,560px)] xl:items-start xl:gap-x-80 xl:gap-y-0 xl:pt-72"
>
  <div class="order-2 flex max-w-[640px] flex-col gap-24 xl:order-none xl:col-start-1 xl:row-span-2 xl:row-start-1 xl:pt-8">
    {/* The brand's display moment, sized between the section headings and the h1. One line at every width: the wider fallback font would wrap it on small phones until Almarai loads, shifting the hero (CLS). */}
    <p lang="ar" dir="rtl" class="m-0 self-start whitespace-nowrap font-display text-[clamp(28px,9vw,60px)] leading-[1.2] text-lapis xl:text-[58px]">{school.nameAr}</p>
    <h1
      id="g-hero-title"
      class="m-0 font-display text-[clamp(52px,6.4vw,92px)] font-semibold leading-[0.95] tracking-[-0.01em] [text-wrap:balance]"
    >
      Hafalan 30&nbsp;juz, ditempuh juz demi&nbsp;juz
    </h1>
    <p class="m-0 max-w-[34em] text-19 leading-[1.6] text-body [text-wrap:pretty]">
      Pesantren tahfizh dan bahasa Arab di kaki Gunung Salak, Bogor. Santri menghafal Al-Qur’an secara mutqin dan
      bersanad, berbahasa Arab aktif, dan tetap menempuh kurikulum nasional.
    </p>
    <div class="flex flex-wrap gap-12">
      <a
        href={registerUrl()}
        class="btn-primary"
      >Daftar santri baru</a>
      <a
        href={school.whatsapp.url}
        class="btn-secondary"
      >
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z"></path></svg>
        Tanya lewat WhatsApp
      </a>
    </div>
    {
      primaryOpen ? (
        <p class="m-0 rounded-md bg-lapis-1 px-18 py-14 text-15 text-body">
          Pendaftaran {openNames} sedang dibuka.{' '}
          <a href={primaryOpen.path} class="font-bold underline-offset-[3px]">Lihat cara mendaftar</a>
        </p>
      ) : (
        <p class="m-0 rounded-md bg-white px-18 py-14 text-15 text-body">
          Pendaftaran santri baru belum dibuka.{' '}
          <a href={infoGroupUrl} class="font-bold underline-offset-[3px]">Gabung grup info WhatsApp</a>
        </p>
      )
    }
    {
      proof && (
        <a href="/prestasi/" class="cta-next -my-6 block min-h-44 self-start box-border py-10 text-15 leading-[1.5] text-body no-underline hover:text-ink">
          <strong class="font-bold text-ink">Prestasi terbaru:</strong>{' '}
          <span class="underline decoration-1 underline-offset-[3px]">{proof}</span>{' '}
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="cta-arrow-next inline-block align-[-3px]"><path d="M4 10h12M11 5l5 5-5 5"></path></svg>
        </a>
      )
    }
  </div>

  {/* LCP image: eager, high priority. Faces sit in the upper half, clear of the map card. */}
  <picture class="order-1 block xl:order-none xl:col-start-2 xl:row-start-1">
    <source
      type="image/webp"
      srcset="/photos/santri-datang-ke-kelas-hero-800.webp 800w, /photos/santri-datang-ke-kelas-hero-1600.webp 1562w"
      sizes="(min-width: 1280px) 560px, (min-width: 640px) calc(100vw - 80px), calc(100vw - 40px)"
    />
    <img
      src="/photos/santri-datang-ke-kelas-hero-1600.jpg"
      width="1562"
      height="1428"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      alt="Dua santri berseragam batik biru dan berpeci berjalan masuk ke area kelas di pagi hari, membawa tas dan buku"
      class="block aspect-[4/3] max-h-[min(64vh,560px)] w-full rounded-xl object-cover object-top xl:aspect-[4/5] xl:max-h-none"
    />
  </picture>

  <div class="card relative z-[1] order-3 box-border min-w-0 xl:order-none xl:col-start-2 xl:row-start-2 xl:ml-[-72px] xl:mt-[-50%]">
    <div class="flex flex-col gap-20 p-20 sm:p-36">
      <div class="flex flex-col gap-6">
        <h2 class="m-0 font-display text-32 font-semibold leading-[1.1]">{map.title}</h2>
        <p class="m-0 max-w-[46em] text-15 text-muted">{map.description}</p>
      </div>
      <JuzMap ariaLabel={map.ariaLabel} classes={map.classes} readouts={map.readouts} />
    </div>
  </div>
</section>
