---
// Phone and tablet menu, below 1024px. Built on the Popover API, so it needs
// no JavaScript: the button opens it, Escape or a tap outside closes it, and
// browsers manage aria-expanded on the button.
import type { NavGroup, NavLink } from '@/lib/nav';

interface Props {
  groups: NavGroup[];
  login: NavLink;
  register: NavLink;
  isCurrent: (href: string) => boolean;
}
const { groups, login, register, isCurrent } = Astro.props;
---
<button
  type="button"
  popovertarget="menu-hp"
  class="inline-flex min-h-44 cursor-pointer items-center gap-8 rounded-sm border border-ink bg-white px-14 font-body text-16 font-bold text-ink transition-transform duration-150 active:scale-[0.97]"
>
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2.5 4.5h13M2.5 9h13M2.5 13.5h13"></path></svg>
  Menu
</button>

<div
  id="menu-hp"
  popover
  aria-label="Menu"
  class="fixed inset-y-0 left-auto right-0 m-0 h-dvh max-h-none w-[min(88%,400px)] max-w-none flex-col overflow-y-auto border-0 border-l border-rule bg-paper p-0 text-ink backdrop:bg-ink/60 [&:popover-open]:flex"
>
  <div class="flex items-center justify-between gap-16 border-b border-rule px-20 py-12">
    <p class="m-0 font-display text-27 font-semibold leading-none">Menu</p>
    <button
      type="button"
      popovertarget="menu-hp"
      popovertargetaction="hide"
      class="inline-flex min-h-44 min-w-44 cursor-pointer items-center justify-center gap-6 rounded-sm border-0 bg-transparent px-8 font-body text-16 font-medium text-ink"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 4l10 10M14 4 4 14"></path></svg>
      Tutup
    </button>
  </div>
  <nav aria-label="Menu utama" class="flex flex-col gap-24 px-20 py-24">
    {
      groups.map((g) => (
        <section class="flex flex-col">
          <h2 class="m-0 mb-4 text-15 font-bold text-ink">{g.label}</h2>
          <ul class="m-0 list-none p-0">
            {g.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={isCurrent(l.href) ? 'page' : undefined}
                  class="flex min-h-44 items-center justify-between gap-12 border-b border-rule text-17 font-medium text-ink no-underline hover:underline aria-[current=page]:font-bold aria-[current=page]:text-lapis"
                >
                  <span>{l.label}</span>
                  {l.note && <span class="text-14 font-normal text-muted">{l.note}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </nav>
  <div class="mt-auto flex flex-col gap-12 border-t border-rule px-20 pb-32 pt-20">
    <a href={register.href} class="btn-primary">{register.label}</a>
    <a href={login.href} class="inline-flex min-h-44 items-center justify-center text-16 font-medium text-ink underline-offset-4">{login.label}</a>
  </div>
</div>
