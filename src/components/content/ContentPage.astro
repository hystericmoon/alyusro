---
// Content page template (design/Kurikulum-tahfizh.dc.html): the shared
// PageHeader (breadcrumb, title, lede, optional photo), then a sticky
// "Di halaman ini" list beside the prose body. Content and conversion pages
// close with the Gunung Salak landscape; utility pages with a compact band.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Landscape from '@/components/home/Landscape.astro';
import PageHeader, { type Crumb, type HeaderPhoto } from '@/components/content/PageHeader.astro';
import ClosingBand from '@/components/content/ClosingBand.astro';

export type { Crumb };
export type TocItem = { id: string; text: string };

interface Props {
  title: string;
  lede: string;
  crumbs: Crumb[];
  toc?: TocItem[];
  description?: string;
  /** Closing band, e.g. { text: 'Lihat target hafalan tiap jenjang', label: 'Pilih jenjang', href: '/#jenjang' } */
  cta?: { text: string; label: string; href: string };
  motion?: boolean;
  photo?: HeaderPhoto;
  /** 'compact' on utility pages (jadwal shalat, konversi nama, kalender, info kajian). */
  closing?: 'landscape' | 'compact';
}
const { title, lede, crumbs, toc = [], description, cta, motion, photo, closing = 'landscape' } = Astro.props;
---
<BaseLayout title={title} description={description ?? lede} footerLabelledBy="g-foot-title" motion={motion}>
  <PageHeader title={title} lede={lede} crumbs={crumbs} photo={photo} />

  <slot name="before" />
  <div class="mx-auto box-border flex max-w-page flex-wrap items-start gap-x-80 gap-y-32 px-20 pb-80 sm:px-40 sm:pb-96">
    {
      toc.length > 1 && (
        <nav aria-label="Isi halaman" class="w-full pt-32 text-15 leading-[1.4] lg:sticky lg:top-0 lg:w-auto lg:flex-[0_1_240px]">
          <p class="m-0 mb-12 font-bold text-muted">Di halaman ini</p>
          <ol class="m-0 flex list-none flex-col gap-2 p-0">
            {toc.map((t) => (
              <li>
                <a href={`#${t.id}`} class="-ml-14 flex min-h-44 items-center rounded-full px-14 text-ink no-underline transition-colors duration-150 hover:bg-white hover:text-lapis">
                  {t.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <article class="prose min-w-0 max-w-[760px] flex-[1_1_560px] pt-32">
      <slot />
      {
        cta && (
          <a href={cta.href} class="cta-next card group mt-64 flex items-center justify-between gap-24 px-24 py-24 text-ink no-underline transition-colors duration-150 hover:text-lapis sm:px-32 sm:py-28">
            <span class="flex min-w-0 flex-col gap-6">
              <span class="text-14 font-bold text-muted">Selanjutnya · {cta.label}</span>
              <span class="font-display text-[clamp(28px,3.4vw,40px)] font-semibold leading-[1.05] [text-wrap:balance]">{cta.text}</span>
            </span>
            <span aria-hidden="true" class="inline-flex size-48 flex-none items-center justify-center rounded-full bg-ink text-white transition-colors duration-150 group-hover:bg-lapis">
              <svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="cta-arrow-next"><path d="M4 10h12M11 5l5 5-5 5"></path></svg>
            </span>
          </a>
        )
      }
    </article>
  </div>
  <slot name="after" />
  {closing === 'compact' ? <ClosingBand slot="footer-lead" /> : <Landscape slot="footer-lead" />}
</BaseLayout>
