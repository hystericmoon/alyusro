---
// Interior page header: breadcrumb, h1, intro and an optional photo.
// With a photo: two columns from 1024px (text left, photo right), photo
// first on phones (CSS order, so reading order stays breadcrumb, h1, intro).
// Without one: a tinted band with the juz-cell motif from the homepage map,
// drawn only in the empty space right of the text (from 1280px), never behind it.
// Spacing matches the level pages (LevelPage.astro).
import Photo from '@/components/Photo.astro';

export type Crumb = { label: string; href?: string };
export type HeaderPhoto = { name: string; alt: string; width: number; height: number };

interface Props {
  title: string;
  lede?: string;
  crumbs: Crumb[];
  photo?: HeaderPhoto;
  /** id of the h1, for aria-labelledby on the section */
  id?: string;
}
const { title, lede, crumbs, photo, id = 'page-title' } = Astro.props;

// 30 cells, one per juz, filled in the homepage map's class order: a quiet
// echo of the hafalan map. Decorative only (aria-hidden).
const motif = Array.from({ length: 30 }, (_, i) => {
  const juz = i + 1;
  if (juz >= 26) return 'bg-lapis-1';
  if (juz <= 10) return 'bg-sky-100';
  if (juz <= 20) return 'bg-white';
  return 'bg-white/60';
});
---
<section aria-labelledby={id} class:list={['relative', !photo && 'overflow-hidden bg-sky-50']}>
  <div class:list={['relative z-[1] mx-auto box-border max-w-page px-20 pt-24 sm:px-40 sm:pt-32', photo ? 'pb-48 sm:pb-64' : 'pb-56 sm:pb-72']}>
    <nav aria-label="Breadcrumb" class="mb-32 text-15 sm:mb-40">
      <ol class="m-0 flex list-none flex-wrap gap-x-10 gap-y-4 p-0 text-muted">
        <li><a href="/" class="underline-offset-[3px]">Beranda</a></li>
        {
          crumbs.map((c, i) => (
            <>
              <li aria-hidden="true">/</li>
              {i === crumbs.length - 1 ? (
                <li aria-current="page" class="text-ink">{c.label}</li>
              ) : c.href ? (
                <li><a href={c.href} class="underline-offset-[3px]">{c.label}</a></li>
              ) : (
                <li>{c.label}</li>
              )}
            </>
          ))
        }
      </ol>
    </nav>
    <div class:list={[photo ? 'flex flex-col gap-32 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] lg:items-center lg:gap-x-64' : 'max-w-[860px] lg:max-w-[760px]']}>
      <div class="order-2 flex flex-col items-start gap-20 lg:order-none">
        <h1 id={id} class="m-0 font-display text-[clamp(52px,6.6vw,96px)] font-semibold leading-[0.92] [text-wrap:balance]">{title}</h1>
        {lede && <p class="m-0 max-w-[36em] text-[21px] leading-[1.6] text-body [text-wrap:pretty]">{lede}</p>}
        <slot />
      </div>
      {
        photo && (
          <Photo
            name={photo.name}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            priority
            sizes="(min-width: 1280px) 520px, (min-width: 1024px) 40vw, (min-width: 640px) calc(100vw - 80px), calc(100vw - 40px)"
            pictureClass="order-1 block lg:order-none"
            class="block aspect-[3/2] w-full rounded-xl object-cover"
          />
        )
      }
    </div>
  </div>
  {
    !photo && (
      <div aria-hidden="true" class="pointer-events-none absolute right-[max(40px,calc((100vw-1280px)/2+40px))] top-1/2 hidden -translate-y-1/2 grid-cols-6 gap-8 xl:grid">
        {motif.map((c) => <span class:list={['block size-32 rounded-sm', c]} />)}
      </div>
    )
  }
</section>
