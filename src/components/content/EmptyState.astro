---
// Designed empty state for content the school has not published yet
// (kalender akademik, kajian times): an icon tile, a headline that says what
// is missing, one line on where the news goes instead, and the two actions
// that replace it: the WhatsApp info group, then a direct question.
import { school, infoGroupUrl } from '@/lib/site';

interface Props {
  title: string;
  icon?: 'calendar' | 'kajian';
  /** id for the headline, so a section can be labelled by it */
  id?: string;
  class?: string;
}
const { title, icon = 'calendar', id, class: className } = Astro.props;
---
<div class:list={['card flex flex-col gap-20 p-24 sm:flex-row sm:gap-28 sm:p-32', className]}>
  <span aria-hidden="true" class="inline-flex size-64 flex-none items-center justify-center rounded-md bg-lapis-1 text-lapis">
    {
      icon === 'calendar' ? (
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15.5" rx="3" /><path d="M8 3v4M16 3v4M3.5 10h17" /><path d="M9.5 15h5" /></svg>
      ) : (
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5C10.2 5 7.6 4.5 4 4.5v13c3.6 0 6.2.5 8 2 1.8-1.5 4.4-2 8-2v-13c-3.6 0-6.2.5-8 2z" /><path d="M12 6.5v13" /></svg>
      )
    }
  </span>
  <div class="flex min-w-0 flex-col items-start gap-12">
    <p id={id} class="m-0 max-w-[24em] font-display text-[clamp(26px,2.6vw,30px)] font-semibold leading-[1.15] text-ink [text-wrap:balance]">{title}</p>
    <div class="m-0 max-w-[40em] text-17 leading-[1.6] text-body [&>p]:m-0"><slot /></div>
    <div class="mt-8 flex flex-wrap gap-12">
      <a href={infoGroupUrl} class="btn-primary">Masuk grup info WhatsApp</a>
      <a href={school.whatsapp.url} class="btn-secondary">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z"></path></svg>
        Tanya lewat WhatsApp
      </a>
    </div>
  </div>
</div>
