---
// Compact closing call to action for utility pages (jadwal shalat, konversi
// nama, kalender akademik, info kajian, 404), in place of the full Gunung
// Salak landscape: one line and the two actions every page ends with.
import { school, registerUrl } from '@/lib/site';
---
<div class="bg-sky-50">
  <div class="mx-auto box-border flex max-w-page flex-wrap items-center justify-between gap-x-40 gap-y-20 px-20 py-40 sm:px-40 sm:py-48">
    <h2 id="g-foot-title" class="m-0 max-w-[22em] font-display text-[clamp(26px,2.8vw,34px)] font-semibold leading-[1.1] [text-wrap:balance]">
      Tanya tim pendaftaran, atau langsung daftarkan anak
    </h2>
    <div class="flex flex-wrap gap-12">
      <a href={school.whatsapp.url} class="btn-secondary bg-white hover:bg-lapis-1">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z"></path></svg>
        WhatsApp {school.whatsapp.display}
      </a>
      <a href={registerUrl()} class="btn-primary">Daftar santri baru</a>
    </div>
  </div>
</div>
